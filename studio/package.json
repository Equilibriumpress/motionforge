{
  "name": "@equilibriumpress/motionforge-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-project-index.mjs && node scripts/build-motion-catalog.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node --test src/preview/stage-fill.test.mjs src/preview/viewport-preview.test.mjs scripts/prepare-three-scene.test.mjs && node --test src/lib/catalog-prompt.test.mjs && node scripts/build-project-index.mjs && node scripts/build-motion-catalog.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "new:project": "node scripts/new-project.mjs",
    "new:template": "node scripts/new-from-template.mjs",
    "qa:projects": "node ../tools/studio-qa.mjs --all",
    "test:studio": "node --test project-templates/library.test.mjs ../tools/studio-qa.test.mjs",
    "test:catalog": "node --test scripts/build-motion-catalog.test.mjs src/lib/catalog-prompt.test.mjs",
    "new:upstream": "node scripts/new-from-upstream.mjs",
    "test:upstream": "node --test scripts/new-from-upstream.test.mjs scripts/new-multi-scene.test.mjs scripts/motion-director-workflow.test.mjs scripts/validate-native-production.test.mjs scripts/build-motion-catalog.test.mjs",
    "director": "node scripts/motion-director-workflow.mjs",
    "new:video": "node scripts/new-multi-scene.mjs",
    "voice:prepare": "node ../tools/studio-voice.mjs",
    "render:doctor": "node ../tools/studio-render-doctor.mjs",
    "render:video": "node ../tools/studio-render.mjs",
    "render:review": "node ../tools/studio-render-review.mjs",
    "test:voice-render": "node --test ../tools/studio-voice.test.mjs ../tools/studio-render-doctor.test.mjs ../tools/studio-render-review.test.mjs",
    "qa:original": "node ../tools/studio-qa-review.mjs",
    "qa:critic": "node ../tools/studio-qa-critic.mjs",
    "qa:annotations": "node ../tools/studio-qa-annotations.mjs",
    "test:qa-original": "node --test ../tools/studio-qa-policy.test.mjs ../tools/studio-qa-review.test.mjs ../tools/studio-qa-critic.test.mjs",
    "test:browser-original": "node --test src/export/hyperframes-plan.test.mjs src/preview/stage-fill.test.mjs src/preview/viewport-preview.test.mjs scripts/prepare-three-scene.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "gsap": "^3.14.2",
    "remotion": "4.0.545",
    "@remotion/player": "4.0.545",
    "@remotion/web-renderer": "4.0.545",
    "three": "0.170.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "mediabunny": "1.66.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "esbuild": "^0.25.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/outfit": "^5.2.0",
    "@fontsource/overpass-mono": "^5.2.0",
    "@fontsource/rubik": "^5.2.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
