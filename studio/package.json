{
  "name": "@equilibriumpress/motionforge-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-project-index.mjs && node scripts/build-motion-catalog.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/build-project-index.mjs && node scripts/build-motion-catalog.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "new:project": "node scripts/new-project.mjs",
    "new:template": "node scripts/new-from-template.mjs",
    "qa:projects": "node ../tools/studio-qa.mjs --all",
    "test:studio": "node --test project-templates/library.test.mjs ../tools/studio-qa.test.mjs",
    "test:catalog": "node --test scripts/build-motion-catalog.test.mjs",
    "new:upstream": "node scripts/new-from-upstream.mjs",
    "test:upstream": "node --test scripts/new-from-upstream.test.mjs scripts/validate-native-production.test.mjs scripts/build-motion-catalog.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "gsap": "^3.14.2",
    "remotion": "4.0.545",
    "@remotion/player": "4.0.545",
    "@remotion/web-renderer": "4.0.545",
    "three": "0.170.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "esbuild": "^0.25.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
